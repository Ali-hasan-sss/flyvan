# Local development only. Copy to .env and do not commit .env.
NODE_ENV=development

# Matches docker-compose.yml. Change both together if you replace the local database.
DATABASE_URL=postgresql://flyvan:flyvan@localhost:5434/flyvan?schema=public

API_PORT=3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# During development the phone replaces localhost and private addresses with the
# address of the machine that served the Expo bundle, so a network change is picked up on reload.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Example label only. It does not decide the production currency.
PLATFORM_DEFAULT_CURRENCY=SYP

# Road routing. Empty uses the public OSRM service. Set off to refuse route estimates.
# ROUTE_OSRM_URL=https://router.project-osrm.org

# Seed stays off until you set a local password of at least 8 characters.
# Leave the commission rate empty unless you intentionally want a development policy.
SEED_ENABLED=false
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
# Optional operations admin. Both fields are required together. Leave empty to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEFAULT_COMMISSION_RATE=

# أضف سر الدخول بعد نسخ الملف. 32 حرفًا عشوائيًا على الأقل.
# JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
